# Backend API URL - Choose one based on your environment
# For local development:
VITE_API_BASE_URL=http://localhost:3000/api/
# For production:
# VITE_API_BASE_URL=https://your-api-domain.com/api/

# App Configuration
VITE_APP_NAME="Trees Social"
VITE_APP_VERSION=1.0.0
VITE_FRONTEND_URL=http://localhost:5173

# Socket.IO Configuration - Choose one based on your environment
# For local development:
VITE_SOCKET_URL=http://localhost:3000
# For production:
# VITE_SOCKET_URL=wss://your-api-domain.com

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/avi

# Feature Flags
VITE_ENABLE_LIVESTREAMING=true
VITE_ENABLE_ARCADE=true
VITE_ENABLE_SUBSCRIPTIONS=true
VITE_ENABLE_ADMIN_PANEL=true

# Development
VITE_DEBUG_MODE=true
VITE_SHOW_PERFORMANCE_METRICS=false
