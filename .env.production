# Production Environment Configuration for Vercel Deployment

# Backend API URL (User's live Render backend service)
VITE_API_BASE_URL=https://trees-backend-xggc.onrender.com/api

# App Configuration
VITE_APP_NAME="Trees Social"
VITE_APP_VERSION=1.0.0
VITE_FRONTEND_URL=https://trees-social.vercel.app

# Socket.IO Real-Time Connection
VITE_SOCKET_URL=https://trees-backend-xggc.onrender.com

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/avi

# Feature Flags
VITE_ENABLE_LIVESTREAMING=true
VITE_ENABLE_ARCADE=true
VITE_ENABLE_SUBSCRIPTIONS=true
VITE_ENABLE_ADMIN_PANEL=true

# Production Debug Flags
VITE_DEBUG_MODE=false
VITE_SHOW_PERFORMANCE_METRICS=false
